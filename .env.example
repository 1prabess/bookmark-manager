# Postgres
POSTGRES_USER=bookmarks
POSTGRES_PASSWORD=change_me_to_a_real_password
POSTGRES_DB=bookmarks
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://bookmarks:realpassword@localhost:5432/bookmarks
DEBUG=false

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me
PGADMIN_PORT=5050

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT 
JWT_SECRET_KEY=replace-me-with-output-of-secrets-token-urlsafe-48
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Elasticsearch 
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200

# Gmail SMTP 
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=